# Build outputs and run artifacts. Leaving these untracked makes every build
# report a modified tree, which hides the staleness check that matters.
/multivenue
/*.test
/logs/
/logs.tar.xz
/.cache/
/bin/

# Working files for an in-progress analysis: backups taken before an edit,
# one-off probes, smoke-run output. Kept in the repo rather than a system
# temporary directory so a run and the notes about it stay together.
/scratch/
/loganalyzer
